    {
      "name": "chatbot",
      "runtimeExecutable": "D:\\Hackathon\\chatbot\\.venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8001",
        "--app-dir",
        "D:\\Hackathon\\chatbot"
      ],
      "port": 8001
    }
  ]
}