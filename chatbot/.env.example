# Copy to chatbot/.env and paste your key. Never commit chatbot/.env.
ANTHROPIC_API_KEY=

# Where the Timetabl.ai backend runs
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Optional overrides
# CHAT_MODEL=claude-opus-5-5
# CHAT_EFFORT=medium

# Optional: better listening + natural voice for the assistant. Either key works (OpenAI direct, or the same
# models through OpenRouter). Without one, the browser's own voice is used.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# VOICE_STT_MODEL=openai/gpt-4o-transcribe
# VOICE_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
# VOICE_TTS_VOICE=coral
