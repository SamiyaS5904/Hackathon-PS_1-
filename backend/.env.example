# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Postgres connection string from Supabase: click "Connect" at the top of the project
# -> Connection string -> Session pooler -> copy the URI and put your database password in it.
# Leave empty to use a local SQLite file for development.
DATABASE_URL=

# Secret used to sign login tokens (any long random string)
APP_SECRET=

# Platform owners (Super Admin), comma separated: they see every college's health and manage plans / pauses
SUPERADMIN_EMAILS=

# Demo platform owner owner@demo.timetabl.ai (demo password) for showing the SaaS view. Set 0 for real colleges.
DEMO_PLATFORM_OWNER=1
