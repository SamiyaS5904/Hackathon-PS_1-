# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Supabase project (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Project Settings -> Database -> Connection string -> URI).
# Leave empty to use a local SQLite file for development.
DATABASE_URL=

# Only needed if Supabase Auth is used (option A)
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Secret used to sign login tokens (any long random string)
APP_SECRET=
